[Unit]
Description=LabFree ImageDeploy - cancela tarefas esquecidas (máquina não ligou pela rede no prazo)
After=mariadb.service mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/local/lib/LabFreeImageDeploy/LabFreeImageDeploy-expirar
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
