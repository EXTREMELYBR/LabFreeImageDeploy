        raise Erro('O FOG (base do sistema) não está instalado.')
    # 1) menu de boot: imagem de fundo, cores, itens e textos
    fundo = f'{MARCA_DIR}/LabFreeImageDeploy-fundo.png'
    if os.path.exists(fundo):
        ref = f'{IPXE_WEB}/bg.png'
        st = os.stat(ref) if os.path.exists(ref) else os.stat(IPXE_WEB)
        copiar_seguro(fundo, f'{IPXE_WEB}/LabFreeImageDeploy-fundo.png', 0o644, (st.st_uid, st.st_gid))
        mysql("UPDATE globalSettings SET settingValue='LabFreeImageDeploy-fundo.png' WHERE settingKey='FOG_IPXE_BG_FILE';")
    for chave, valor in CORES_IPXE.items():
        mysql(f"UPDATE globalSettings SET settingValue='{valor}' WHERE settingKey='{chave}';")
    for chave, texto in MENU_BOOT.items():
        mysql(f"UPDATE pxeMenu SET pxeDesc='{texto}' WHERE pxeName='{chave}';")
    # menos itens na tela: troca de chave de produto e exclusão pelo boot ficam escondidos (o painel faz isso)
    mysql("UPDATE pxeMenu SET pxeRegOnly=99 WHERE pxeName IN ('fog.keyreg','fog.quickdel');")
    # Secure Boot não funciona com o iPXE recompilado (sem assinatura): o item só confundiria
    if not os.path.exists('/var/www/html/fog/service/secureboot/shimx64.efi'):
        mysql("UPDATE pxeMenu SET pxeRegOnly=99 WHERE pxeName='fog.enrollsecureboot';")
    # o cadastro automático usa o padrão de nomes do painel (ex.: LAB-001)
    mysql("UPDATE globalSettings SET settingValue='1' WHERE settingKey='FOG_QUICKREG_AUTOPOP';")
    if mysql("SELECT settingValue FROM globalSettings WHERE settingKey='FOG_QUICKREG_SYS_NAME'").strip() in ('', 'PC-*', 'MAC'):
        mysql("UPDATE globalSettings SET settingValue='LAB-***' WHERE settingKey='FOG_QUICKREG_SYS_NAME';")
    # endereços do LabFree usados pelo sistema de clonagem (cadastro guiado, etapa ao vivo)
    st = os.stat('/var/www/html/fog/service')
    for arq in sorted(glob.glob(f'{MARCA_DIR}/servidor/LabFreeImageDeploy-*.php')):
        copiar_seguro(arq, f'/var/www/html/fog/service/{os.path.basename(arq)}', 0o644, (st.st_uid, st.st_gid))
    mysql(TABELA_ETAPAS)
    mysql(TABELA_IMAGENS)
    feito.append('menu de boot: fundo, cores e itens em português')
    # a máquina não escolhe nada sozinha no menu de boot (0 = esperar alguém escolher). Só na primeira vez:
    # depois vale o que o administrador escolher no painel (Configurações → Cadastro pelo boot)
    if not os.path.exists(MENU_ESPERA_MARCADOR):
        mysql("UPDATE globalSettings SET settingValue='0' WHERE settingKey='FOG_PXE_MENU_TIMEOUT';")
        gravar_atomico(MENU_ESPERA_MARCADOR, datetime.datetime.now().isoformat() + '\n', 0o600)
        feito.append('menu de boot: espera a escolha de alguém (não inicia sozinho)')
    texto_porteiro = porteiro_aplicar(inst)
    if texto_porteiro:
        feito.append(texto_porteiro)
    if os.path.exists(BOOTMENU_PHP):
        texto = open(BOOTMENU_PHP).read()
        novo = texto
        for a, b in BOOTMENU_TROCAS:
            novo = novo.replace(a, b)
        if novo != texto:
            inst.guardar(BOOTMENU_PHP)
            gravar_atomico(BOOTMENU_PHP, novo)
            feito.append('textos de cadastro do menu de boot')
    if os.path.exists(REGISTRO_PHP):
        texto = open(REGISTRO_PHP).read()
        novo = texto
        for a, b in REGISTRO_TROCAS:
            novo = novo.replace(a, b)
        if novo != texto:
            inst.guardar(REGISTRO_PHP)
            gravar_atomico(REGISTRO_PHP, novo)
            feito.append('correções no cadastro automático')
    # 2) sistema de clonagem (FOS)
    for nome in ('init.xz', 'init_32.xz'):
        r = marca_fos(nome)
        if r:
            feito.append(f'banner do sistema de clonagem ({nome})')
    # 3) interface antiga do FOG desligada
    if os.path.isdir('/etc/apache2/conf-available'):
        inst.guardar(APACHE_LABFREE)
        gravar_atomico(APACHE_LABFREE, APACHE_CONF, 0o644)
        sh(['a2enconf', '-q', 'LabFreeImageDeploy'], verificar=False)
        r = sh(['apache2ctl', 'configtest'], verificar=False)
        if r.returncode != 0:
            inst.restaurar()
            sh(['a2disconf', '-q', 'LabFreeImageDeploy'], verificar=False)
            raise Erro('O Apache recusou a configuração que desliga a interface antiga: ' + r.stderr.strip()[-300:])
        sh(['systemctl', 'reload', 'apache2'], verificar=False)
        feito.append('interface antiga /fog desligada (redireciona para o painel)')
    # 4) autonomia: nada busca atualização do FOG
    if os.path.exists(FOGSETTINGS):
        fogsettings_gravar({'sendreports': 'N'}, inst)
    mysql("UPDATE globalSettings SET settingValue='0' WHERE settingKey IN ('FOG_CLIENT_AUTOUPDATE');")
    hosts = open('/etc/hosts').read()
    if HOSTS_MARCA[0] not in hosts:
        inst.guardar('/etc/hosts')
        gravar_atomico('/etc/hosts', hosts.rstrip('\n') + '\n' + '\n'.join(HOSTS_MARCA) + '\n')
    feito.append('sem relatório de uso, sem autoatualização e sem acesso a fogproject.org')
    log('marca-aplicar ok: ' + '; '.join(feito))
    return {'ok': True, 'msg': 'Marca LabFree ImageDeploy aplicada.', 'feito': feito}


