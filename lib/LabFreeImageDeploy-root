COPIAS = '/usr/local/lib/LabFreeImageDeploy/LabFreeImageDeploy-copias'


def copias(e):
    """Cópias de imagens para HD externo / pasta de rede (o programa próprio valida a entrada e tem sua trava)."""
    if not os.path.exists(COPIAS):
        raise Erro('Cópias de imagens não instaladas. Rode o instalador de novo.')
    r = subprocess.run([sys.executable, '-I', COPIAS], input=json.dumps(e), capture_output=True, text=True, timeout=300)
    try:
        saida = json.loads(r.stdout)
    except ValueError:
        raise Erro('Falha nas cópias: ' + (r.stderr.strip()[-300:] or 'sem resposta'))
    if 'erro' in saida:
        raise Erro(saida['erro'])
    return saida


ACOES = {'status': status, 'dhcp-ler': dhcp_ler, 'dhcp-aplicar': dhcp_aplicar,
         'rede-listar': rede_listar, 'rede-simular': rede_simular, 'rede-aplicar': rede_aplicar, 'reaplicar': reaplicar,
         'imagem-apagar': imagem_apagar, 'marca-aplicar': marca_aplicar,
         'servicos-aplicar': lambda e=None: {'ok': True, 'criados': servicos_aplicar()}, 'recuperar': recuperar,
         'copias': copias, 'nat-ler': nat_ler, 'nat-aplicar': nat_aplicar, 'nat-restaurar': nat_restaurar,
         'dev-orfas': dev_orfas}


# o painel (www-data via sudo) só pode pedir estas ações; o resto é para o administrador e o instalador
ACOES_PAINEL = {'status', 'dhcp-ler', 'dhcp-aplicar', 'rede-listar', 'rede-simular', 'rede-aplicar', 'imagem-apagar', 'copias',
                'nat-ler', 'nat-aplicar', 'dev-orfas'}
ACOES_LEITURA = {'status', 'dhcp-ler', 'rede-listar', 'rede-simular', 'copias', 'nat-ler'}  # copias tem trava própria  # (recuperar trava como as alterações)
TRAVA = '/run/LabFreeImageDeploy.lock'


def travar(segundos):
    """Uma alteração por vez (painel, instalador, comandos)."""
    fd = os.open(TRAVA, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fim = time.time() + segundos
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.time() >= fim:
                os.close(fd)
                raise Erro('Outra alteração está sendo aplicada agora. Aguarde um minuto e tente de novo.')
            time.sleep(0.5)


def main():
    if os.geteuid() != 0:
        print(json.dumps({'erro': 'Precisa ser executado como root (sudo).'}))
        return 1
    if len(sys.argv) != 2 or sys.argv[1] not in ACOES:
        print(json.dumps({'erro': f"Uso: LabFreeImageDeploy-root {{{'|'.join(ACOES)}}} < entrada.json"}))
        return 1
    acao = sys.argv[1]
    if os.environ.get('SUDO_USER') == 'www-data' and acao not in ACOES_PAINEL:
        print(json.dumps({'erro': 'Ação não permitida pelo painel.'}, ensure_ascii=False))
        return 1
    bruto = '' if sys.stdin.isatty() else sys.stdin.read(65536)
    if acao == 'rede-aplicar' and not os.environ.get('LABFREE_DESTACADO') and shutil.which('systemd-run'):
        # roda numa unidade própria do systemd: reiniciar o Apache/PHP durante a troca não mata o ajudante
        # no meio (o que deixaria a rede meio trocada e sem desfazer)
        r = subprocess.run(['systemd-run', '--quiet', '--wait', '--pipe', '--collect',
                            f'--unit=LabFreeImageDeploy-rede-{os.getpid()}', '--setenv=LABFREE_DESTACADO=1',
                            f"--setenv=SUDO_USER={os.environ.get('SUDO_USER', '')}",
                            sys.executable, '-I', os.path.realpath(__file__), acao],
                           input=bruto, capture_output=True, text=True)
        sys.stdout.write(r.stdout)
        if r.returncode != 0 and not r.stdout.strip():
            print(json.dumps({'erro': f'Falha ao iniciar a alteração: {r.stderr.strip()[-300:]}'}, ensure_ascii=False))
        return r.returncode
    try:
        if acao not in ACOES_LEITURA:
            # quem chama pelo painel não espera muito; o instalador e os comandos esperam a vez
            travar(20 if os.environ.get('SUDO_USER') == 'www-data' else 1800)
            if acao != 'recuperar' and os.path.exists(REDE_PENDENTE):
                recuperar()  # uma troca anterior morreu no meio: primeiro desfaz
        entrada = json.loads(bruto) if bruto.strip() else {}
        if entrada == []:  # lista vazia vinda do PHP equivale a "sem dados"
            entrada = {}
        if not isinstance(entrada, dict):
            raise Erro('Entrada inválida.')
        print(json.dumps(ACOES[sys.argv[1]](entrada), ensure_ascii=False, default=str))
        return 0
    except Erro as ex:
        print(json.dumps({'erro': str(ex)}, ensure_ascii=False))
        return 1
    except json.JSONDecodeError:
        print(json.dumps({'erro': 'Entrada JSON inválida.'}, ensure_ascii=False))
        return 1
    except Exception as ex:  # erro inesperado: registra e devolve mensagem genérica
        log(f"ERRO inesperado em {sys.argv[1]}: {type(ex).__name__}: {ex}")
        print(json.dumps({'erro': f'Erro inesperado: {ex}'}, ensure_ascii=False))
        return 1


if __name__ == '__main__':
    sys.exit(main())
