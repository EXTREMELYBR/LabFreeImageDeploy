        gravar_atomico(GRUPO_TMPFILES, GRUPO_TMPFILES_CONF, 0o644)
    sh(['systemd-tmpfiles', '--create', GRUPO_TMPFILES], verificar=False)
    mysql(f"UPDATE globalSettings SET settingValue='{GRUPO_ESPERA_MIN}' WHERE settingKey='FOG_UDPCAST_MAXWAIT';")
