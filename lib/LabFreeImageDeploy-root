    if not os.path.exists(PORTEIRO) or not os.path.exists(FOG_CONFIG_PHP):
        return None
    texto = open(FOG_CONFIG_PHP).read()
    novo = re.sub(r"define\(\s*'UDPSENDERPATH'\s*,\s*'[^']*'\s*\)", f"define('UDPSENDERPATH', '{PORTEIRO}')", texto)
