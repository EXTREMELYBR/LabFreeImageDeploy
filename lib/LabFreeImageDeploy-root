def escrever_nm_carrier(iface, inst):
    """Mantém o IP fixo da rede FOG quando o link cai por segundos (cliente PXE reiniciando
    a placa). Sem isto o NetworkManager tira o IP e o udp-sender do multicast morre com
    'Set multicast send interface: Cannot assign requested address'."""
    inst.guardar(NM_CARRIER)
    gravar_atomico(NM_CARRIER, f"""# LabFree ImageDeploy (gerado pelo LabFreeImageDeploy-root): a placa da rede de clonagem mantém o IP fixo mesmo
# quando o link cai por alguns segundos (cliente PXE reiniciando a placa). Sem isto o
# NetworkManager tira o IP e o envio multicast (udp-sender) morre.
[device-LabFreeImageDeploy]
match-device=interface-name:{iface}
ignore-carrier=yes
""")
    sh(['nmcli', 'general', 'reload', 'conf'], verificar=False)


def escrever_chrony(rede, inst):
    inst.guardar(CHRONY_FOG)
    os.makedirs(os.path.dirname(CHRONY_FOG), exist_ok=True)
    gravar_atomico(CHRONY_FOG, f"""# LabFree ImageDeploy (gerado pelo LabFreeImageDeploy-root): serve a hora para os clientes PXE da rede FOG.
# O iPXE executa "ntp <IP do FOG>" (default.ipxe) antes de validar o certificado
# HTTPS; sem isso, clientes com relógio de BIOS errado falham com
# "Permission denied (ipxe.org/0216eb8f)".
allow {rede}
# Continua servindo hora mesmo sem internet (usa o relógio local)
local stratum 10 orphan
""")


def reemitir_certificado(ip, inst):
    """Reemite o certificado do site com o novo IP, assinado pela mesma 'FOG Web CA'
    (o iPXE confia na CA raiz do FOG, então não precisa recompilar nada)."""
    leaf = f'{PKI_WEB}/leaf'
    chave, cert, csr, sans = f'{leaf}/.webLeaf.key', f'{leaf}/.webLeaf.pem', f'{leaf}/.webLeaf.csr', f'{leaf}/.webLeaf.sans'
    ca_pem, ca_key, cadeia = f'{PKI_WEB}/ca/.fogWebCA.pem', f'{PKI_WEB}/ca/.fogWebCA.key', f'{PKI_WEB}/ca/.fogWebCAchain.pem'
    for f in (chave, ca_pem, ca_key):
        if not os.path.exists(f):
            raise Erro(f'Certificado do FOG não encontrado ({f}).')
    texto = sh(['openssl', 'x509', '-in', cert, '-noout', '-ext', 'subjectAltName'], verificar=False).stdout
    nomes = [n for n in re.findall(r'DNS:([^,\s]+)', texto)] or [os.uname().nodename]
    alt = f"IP.1 = {ip}\n" + ''.join(f"DNS.{i} = {n}\n" for i, n in enumerate(nomes, 1))
    for f in (cert, csr, sans, f'{SSL_DIR}/ca.cnf', f'{SSL_DIR}/req.cnf'):
        inst.guardar(f)
    os.makedirs(SSL_DIR, exist_ok=True)
    ca_cnf = f"[v3_ca]\nsubjectAltName = @alt_names\n[alt_names]\n{alt}"
    req_cnf = ("[req]\ndistinguished_name = req_distinguished_name\nreq_extensions = v3_req\nprompt = yes\n"
               f"[req_distinguished_name]\nCN = {ip}\nO = FOG Project\nOU = FOG Client Communication\n"
               f"[v3_req]\nsubjectAltName = @alt_names\n[alt_names]\n{alt}")
    # o openssl lê as configurações de uma pasta só do root (a pasta do FOG tem pai gravável por outros usuários)
    privada = tempfile.mkdtemp(prefix='cert-')
    try:
        for nome_cnf, conteudo in (('ca.cnf', ca_cnf), ('req.cnf', req_cnf)):
            with open(f'{privada}/{nome_cnf}', 'w') as f:
                f.write(conteudo)
        cn = nomes[0]
        sh(['openssl', 'req', '-new', '-sha512', '-key', chave, '-out', csr, '-config', f'{privada}/req.cnf',
            '-subj', f'/CN={cn}/O=FOG Project/OU=FOG Web UI'])
        novo = cert + '.LabFreeImageDeploy-novo'
        sh(['openssl', 'x509', '-req', '-in', csr, '-CA', ca_pem, '-CAkey', ca_key, '-CAcreateserial',
            '-out', novo, '-days', '1825', '-extensions', 'v3_ca', '-extfile', f'{privada}/ca.cnf'])
    finally:
        shutil.rmtree(privada, ignore_errors=True)
    gravar_atomico(f'{SSL_DIR}/ca.cnf', ca_cnf, 0o644)
    gravar_atomico(f'{SSL_DIR}/req.cnf', req_cnf, 0o644)
    sh(['openssl', 'verify', '-CAfile', cadeia, novo])
    atual = os.stat(cert)
    os.chown(novo, atual.st_uid, atual.st_gid)
    os.chmod(novo, atual.st_mode & 0o7777)
    os.replace(novo, cert)
    # mesmo carimbo que o instalador do FOG usa para saber que o certificado está em dia
    carimbo = sh(['openssl', 'md5'], entrada=open(f'{SSL_DIR}/ca.cnf').read() +
                 sh(['openssl', 'x509', '-in', ca_pem, '-noout', '-fingerprint', '-sha256']).stdout).stdout
    gravar_atomico(sans, carimbo, 0o644)


def garantir_ipxe_ntp(ip, inst):
    """O iPXE acerta o relógio pelo NTP do servidor antes de validar o HTTPS (evita 0216eb8f)."""
    if not os.path.exists(DEFAULT_IPXE):
        return False
    texto = open(DEFAULT_IPXE).read()
    if re.search(rf'^ntp {re.escape(str(ip))}\b', texto, re.M) or not re.search(r'^chain https://', texto, re.M):
        return False
    inst.guardar(DEFAULT_IPXE)
    novo = re.sub(r'^ntp \S+ .*\n', '', texto, flags=re.M)
    novo = re.sub(r'^(chain https://)', f'ntp {ip} || echo NTP {ip} falhou, usando o relogio da BIOS\n\\1', novo, count=1, flags=re.M)
    gravar_atomico(DEFAULT_IPXE, novo)
    return True


def banco_ler_rede():
    linhas = mysql("SELECT settingKey, settingValue FROM globalSettings WHERE settingKey IN "
                   "('FOG_TFTP_HOST','FOG_WEB_HOST','FOG_NFS_ETH_MONITOR','FOG_UDPCAST_INTERFACE');")
    d = dict(l.split('\t', 1) for l in linhas.splitlines() if '\t' in l)
    no = mysql("SELECT ngmID, ngmHostname, ngmInterface FROM nfsGroupMembers;")
    return d, [l.split('\t') for l in no.splitlines() if l]


def banco_gravar_rede(ip_velho, ip_novo, if_velho, if_novo):
    # valores já validados (IPv4 e nome de interface), seguros para o SQL
    mysql(f"UPDATE globalSettings SET settingValue='{ip_novo}' WHERE settingKey IN ('FOG_TFTP_HOST','FOG_WEB_HOST') AND settingValue IN ('{ip_velho}','');"
          f"UPDATE globalSettings SET settingValue='{if_novo}' WHERE settingKey IN ('FOG_NFS_ETH_MONITOR','FOG_UDPCAST_INTERFACE') AND settingValue IN ('{if_velho}','');"
          f"UPDATE nfsGroupMembers SET ngmHostname='{ip_novo}' WHERE ngmHostname='{ip_velho}';"
          f"UPDATE nfsGroupMembers SET ngmInterface='{if_novo}' WHERE ngmInterface='{if_velho}';")


def sqlq(v):
    """Texto para dentro de aspas simples no SQL (os valores vêm do próprio banco, que o www-data pode alterar)."""
    return str(v).replace('\\', '\\\\').replace("'", "\\'").replace('\0', '')


def banco_restaurar(config, nos):
    sql = ''
    for k, v in config.items():
        sql += f"UPDATE globalSettings SET settingValue='{sqlq(v)}' WHERE settingKey='{sqlq(k)}';"
    for ng_id, host, iface in nos:
        sql += f"UPDATE nfsGroupMembers SET ngmHostname='{sqlq(host)}', ngmInterface='{sqlq(iface)}' WHERE ngmID={int(ng_id)};"
    if sql:
        mysql(sql)


# Serviços da base FOG expostos com o nome do produto (os originais ficam desligados).
SERVICOS_FOG = {
    'FOGMulticastManager': ('multicast', 'Envio de imagens em grupo (multicast)'),
    'FOGScheduler': ('agendador', 'Agendador de tarefas'),
    'FOGImageReplicator': ('replicacao-imagens', 'Replicação de imagens'),
    'FOGSnapinReplicator': ('replicacao-snapins', 'Replicação de snapins'),
    'FOGPingHosts': ('ping', 'Verificação de máquinas ligadas'),
    'FOGImageSize': ('tamanho-imagens', 'Cálculo do tamanho das imagens'),
    'FOGSnapinHash': ('hash-snapins', 'Verificação de snapins'),
}


def nome_servico(fog):
    return f'LabFreeImageDeploy-{SERVICOS_FOG[fog][0]}'


def servicos_aplicar(_entrada=None):
    """Cria LabFreeImageDeploy-*.service a partir dos serviços do FOG e desliga os originais."""
    feito = []
    for fog, (curto, desc) in SERVICOS_FOG.items():
        origem = next((d for d in ('/etc/systemd/system', '/lib/systemd/system', '/usr/lib/systemd/system')
                       if os.path.exists(f'{d}/{fog}.service')), None)
        if not origem:
            continue
        execstart = next((l.split('=', 1)[1].strip() for l in open(f'{origem}/{fog}.service') if l.startswith('ExecStart=')), '')
        if not execstart:
            continue
        novo = f'/etc/systemd/system/{nome_servico(fog)}.service'
        conteudo = (f"# LabFree ImageDeploy (gerado pelo LabFreeImageDeploy-root a partir de {fog}.service)\n"
                    f"[Unit]\nDescription=LabFree ImageDeploy - {desc}\n"
                    "After=syslog.target network.target network-online.target mariadb.service mysql.service\n"
                    f"Conflicts={fog}.service\nStartLimitIntervalSec=0\n\n"
                    f"[Service]\nType=simple\nRestart=always\nRestartSec=1\nExecStart={execstart}\n\n"
                    "[Install]\nWantedBy=multi-user.target\n")
        if not os.path.exists(novo) or open(novo).read() != conteudo:
            gravar_atomico(novo, conteudo, 0o644)
            feito.append(nome_servico(fog))
    if feito:
        sh(['systemctl', 'daemon-reload'], verificar=False)
    for fog in SERVICOS_FOG:
        if os.path.exists(f'/etc/systemd/system/{nome_servico(fog)}.service'):
            if servico_ativo(fog) or servico_habilitado(fog):
                sh(['systemctl', 'disable', '--now', f'{fog}.service'], verificar=False)
            sh(['systemctl', 'enable', '--now', f'{nome_servico(fog)}.service'], verificar=False)
    return feito


def reiniciar_servicos_fog():
    # o PHP-FPM não precisa reiniciar (lê config.class.php a cada pedido) e reiniciá-lo derrubaria o próprio painel
    servicos = ['apache2', 'chrony']
    for fog in SERVICOS_FOG:
        servicos.append(nome_servico(fog) if os.path.exists(f'/etc/systemd/system/{nome_servico(fog)}.service') else fog)
    for s in servicos:
        if s == 'apache2':
            # reload = "graceful": o pedido do painel que chamou este ajudante não é morto no meio
            if sh(['systemctl', 'reload', s], verificar=False).returncode == 0:
                continue
        sh(['systemctl', 'try-restart', s], verificar=False)


def web_ok(ip):
    """O FOG responde? (menu de boot por HTTP e painel por HTTPS, no IP indicado)."""
    for url in (f'http://{ip}/fog/service/ipxe/boot.php', f'https://{ip}/LabFreeImageDeploy/api.php?a=sessao'):
        ok = False
        for _ in range(10):
            r = sh(['curl', '-sk', '-o', '/dev/null', '-w', '%{http_code}', '--max-time', '5', url], verificar=False)
            if r.stdout.strip() == '200':
                ok = True
                break
            time.sleep(1)
        if not ok:
            return False
    return True


REDE_PENDENTE = '/var/lib/LabFreeImageDeploy/rede-pendente.json'


def diario(dados):
    """Anota o necessário para desfazer uma troca de rede interrompida (queda de energia, desligar no meio)."""
    if dados is None:
        if os.path.exists(REDE_PENDENTE):
            os.remove(REDE_PENDENTE)
            sincronizar_pasta(os.path.dirname(REDE_PENDENTE))
        return
    gravar_atomico(REDE_PENDENTE, json.dumps(dados, default=str), 0o600)


def recuperar(_entrada=None):
    """Se uma troca de rede ficou pela metade, devolve tudo ao estado anterior. Roda no boot e antes de cada alteração."""
    if not os.path.exists(REDE_PENDENTE):
        return {'ok': True, 'msg': 'Nada a recuperar.'}
    try:
        d = json.load(open(REDE_PENDENTE))
    except (OSError, ValueError):
        os.remove(REDE_PENDENTE)
        return {'ok': True, 'msg': 'Diário ilegível descartado.'}
    log(f"recuperar: troca de rede interrompida encontrada ({d.get('dir')}); desfazendo")
    try:
        Instantaneo.do_manifesto(d['dir']).restaurar()
    except (OSError, ValueError, KeyError) as ex:
        log(f"recuperar: não foi possível ler as cópias: {ex}")
    if d.get('banco'):
        try:
            banco_restaurar(*d['banco'])
        except Exception as ex:
            log(f"recuperar: ERRO ao restaurar o banco: {ex}")
    velho = d.get('velho_conf') or {}
    nm_reverter(velho, d.get('nm') or {})
    sh(['systemctl', 'daemon-reload'], verificar=False)
    reiniciar_servicos_fog()
    kea_reiniciar_seguro(velho)
    diario(None)
    log('recuperar: troca de rede interrompida desfeita')
    return {'ok': True, 'msg': 'Uma troca de rede interrompida foi desfeita.'}


