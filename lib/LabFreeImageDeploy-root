def sha256(caminho):
    import hashlib
    h = hashlib.sha256()
    with open(caminho, 'rb') as f:
        for bloco in iter(lambda: f.read(1 << 20), b''):
            h.update(bloco)
    return h.hexdigest()


def marca_fos(nome):
    """Troca o banner do sistema de clonagem (FOS) dentro do init.xz. Idempotente."""
    alvo = f'{IPXE_WEB}/{nome}'
    if not os.path.exists(alvo):
        return None
    import hashlib
    carimbo = f'/var/lib/LabFreeImageDeploy/marca-{nome}.sha256'
    h = hashlib.sha256(BANNER_FOS.encode())
    for raiz, _, arqs in sorted(os.walk(f'{MARCA_DIR}/fos')):
        for a in sorted(arqs):
            h.update(a.encode()); h.update(open(os.path.join(raiz, a), 'rb').read())
    versao_banner = h.hexdigest()[:16]
    atual = sha256(alvo)
    salvo = open(carimbo).read().split() if os.path.exists(carimbo) else []
    # o original do FOG fica numa pasta só do root (a pasta do site é gravável por outros usuários)
    os.makedirs(FOS_ORIGINAIS, mode=0o700, exist_ok=True)
    original = f'{FOS_ORIGINAIS}/{nome}'
    antigo = alvo + '.fog-original'  # versões até 0.5.0 guardavam ao lado do arquivo
    if not os.path.exists(original) and os.path.isfile(antigo) and not os.path.islink(antigo):
        if sh(['sh', '-c', 'xz -dc "$1" | grep -aqF "LabFree ImageDeploy (banner"', '-', antigo],
              verificar=False, tempo=300).returncode != 0:
            copiar_seguro(antigo, original, 0o600, (0, 0))
    if salvo[:1] == [atual] and salvo[1:2] == [versao_banner] and os.path.exists(original):
        return False  # já é a versão LabFree com este banner
    if salvo[:1] != [atual] or not os.path.exists(original):
        # o arquivo atual vira a base, mas só se for do FOG (sem a nossa marca); senão mantém o original guardado
        com_marca = sh(['sh', '-c', 'xz -dc "$1" | grep -aqF "LabFree ImageDeploy (banner"', '-', alvo],
                       verificar=False, tempo=300).returncode == 0
        if not com_marca:
            copiar_seguro(alvo, original, 0o600, (0, 0))
        elif not os.path.exists(original):
            raise Erro(f'{alvo} já tem a marca e o original do FOG não foi encontrado.')
    base = original
    os.makedirs('/var/lib/LabFreeImageDeploy', exist_ok=True)
    tmp = tempfile.mkdtemp(prefix='fos-', dir='/var/lib/LabFreeImageDeploy')
    os.makedirs(f'{tmp}/mnt')
    montado = False

    def dentro(caminho):  # nada dentro da imagem pode apontar para fora dela
        if not os.path.realpath(caminho).startswith(os.path.realpath(f'{tmp}/mnt') + '/') or os.path.islink(caminho):
            raise Erro(f'Arquivo suspeito dentro de {nome}: {os.path.relpath(caminho, tmp)}')
        return caminho
    img = f'{tmp}/init.img'
    try:
        with open(img, 'wb') as f:
            subprocess.run(['xz', '-dc', base], stdout=f, check=True, timeout=600)
        sh(['mount', '-t', 'ext4', '-o', 'loop,nosuid,nodev', img, f'{tmp}/mnt'])
        montado = True
        try:
            funcs = dentro(f'{tmp}/mnt/usr/share/fog/lib/funcs.sh')
            if 'displayBanner() {' not in open(funcs).read():
                raise Erro(f'Formato inesperado do {nome} (displayBanner não encontrado).')
            texto = open(funcs).read()
            ini = texto.index('displayBanner() {')
            fim = texto.index('\n}\n', ini) + 3
            # no fim do funcs.sh: ajustes do LabFree (erros vão para a tela final em vez de reiniciar)
            novo = texto[:ini] + BANNER_FOS + texto[fim:]
            novo += '\n# LabFree ImageDeploy\n[[ -r /usr/share/fog/lib/labfree-tela.sh ]] && . /usr/share/fog/lib/labfree-tela.sh\n'
            open(funcs, 'w').write(novo)
            open(dentro(f'{tmp}/mnt/etc/issue'), 'w').write('LabFree ImageDeploy - Clonagem de maquinas pela rede\n')
            # arquivos do LabFree dentro do sistema de clonagem (ex.: cadastro guiado em /bin/fog.man.reg)
            for raiz, _, arqs in os.walk(f'{MARCA_DIR}/fos'):
                for a in arqs:
                    origem = os.path.join(raiz, a)
                    destino = os.path.join(f'{tmp}/mnt', os.path.relpath(origem, f'{MARCA_DIR}/fos'))
                    os.makedirs(os.path.dirname(destino), exist_ok=True)
                    dentro(os.path.dirname(destino))
                    if os.path.lexists(destino):
                        dentro(destino)
                    if os.path.exists(destino) and not os.path.exists(destino + '.fog-original'):
                        shutil.copy2(destino, destino + '.fog-original')
                    shutil.copy2(origem, destino)
                    executavel = '/bin/' in destino or '/init.d/' in destino
                    os.chmod(destino, 0o755 if executavel else 0o644)
        finally:
            if sh(['umount', f'{tmp}/mnt'], verificar=False).returncode == 0:
                montado = False
            else:
                log(f'ERRO: não consegui desmontar {tmp}/mnt')
        sh(['xz', '-9', '-T1', '--check=crc32', '--lzma2=dict=64MiB', '-f', img], tempo=900)
        sh(['xz', '-t', img + '.xz'])
        st = os.stat(alvo)
        os.chown(img + '.xz', st.st_uid, st.st_gid)
        os.chmod(img + '.xz', st.st_mode & 0o7777)
        os.replace(img + '.xz', alvo)
        gravar_atomico(carimbo, f'{sha256(alvo)} {versao_banner}\n', 0o644)
    finally:
        if not montado:  # nunca apagar por dentro de uma imagem ainda montada
            shutil.rmtree(tmp, ignore_errors=True)
    return True


