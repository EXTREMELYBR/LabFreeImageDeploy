# ------------------------------------------------------------------ NAT (internet para a rede de clonagem)
# Opcional, desligado por padrão. Ligado: repasse (ip_forward) + masquerade numa tabela própria do nftables, só da
# rede de clonagem para as outras placas; o DHCP passa a entregar o servidor como gateway e um DNS. A conexão de
# internet do servidor e a rota padrão NUNCA são alteradas. Desligado: tudo volta como estava (gateway/DNS do DHCP,
# ip_forward, regra do ufw).
NAT_CONF = '/etc/LabFreeImageDeploy/nat.json'
NAT_TABELA = 'labfreeimagedeploy_nat'
NAT_SYSCTL = '/etc/sysctl.d/90-LabFreeImageDeploy-nat.conf'
NAT_SERVICO = 'LabFreeImageDeploy-nat.service'
NAT_DNS_PADRAO = ['1.1.1.1', '8.8.8.8']


def nat_conf():
    try:
        with open(NAT_CONF) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def nat_saida():
    """Placa e tipo da saída para a internet (rota padrão) — só leitura."""
    r = sh(['ip', '-j', 'route', 'show', 'default'], verificar=False)
    try:
        rotas = json.loads(r.stdout or '[]')
    except ValueError:
        rotas = []
    if not rotas:
        return None
    dev = rotas[0].get('dev', '')
    tipo = 'wifi' if os.path.isdir(f'/sys/class/net/{dev}/wireless') else 'cabo'
    return {'placa': dev, 'tipo': tipo, 'gateway': rotas[0].get('gateway', '')}


def nat_dns_da_saida(dev):
    """DNS que o servidor recebeu na placa de internet (as máquinas não alcançam o 127.0.0.53 do servidor)."""
    if not dev or not RE_IFACE.match(dev):
        return []
    r = sh(['nmcli', '-g', 'IP4.DNS', 'device', 'show', dev], verificar=False)
    dns = []
    for linha in r.stdout.replace('|', '\n').splitlines():
        try:
            ip = ipaddress.IPv4Address(linha.strip())
        except ValueError:
            continue
        if not ip.is_loopback:
            dns.append(str(ip))
    return dns[:2]


def nat_firewall():
    """Firewall que bloquearia o repasse: ufw ativo (política de repasse DROP) ou outra tabela com forward DROP."""
    ufw = shutil.which('ufw') and 'Status: active' in sh(['ufw', 'status'], verificar=False).stdout
    regras = sh(['nft', 'list', 'ruleset'], verificar=False).stdout
    outro = bool(re.search(r'hook forward[^\n]*policy drop', regras)) and not ufw
    return {'ufw': bool(ufw), 'outro_bloqueio': outro}


def nat_regras_texto(iface, rede):
    return f"""table ip {NAT_TABELA} {{
  chain repasse {{
    type filter hook forward priority -1; policy accept;
    iifname "{iface}" ip saddr {rede} oifname != "{iface}" accept
    iifname != "{iface}" oifname "{iface}" ct state established,related accept
  }}
  chain saida {{
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr {rede} oifname != "{iface}" masquerade
  }}
}}
"""


def nat_carregar(conf):
    """Liga o repasse e (re)cria a tabela do NAT a partir da configuração atual da rede de clonagem."""
    iface, ip, pref = conf.get('FOG_IFACE', ''), conf.get('FOG_IP', ''), conf.get('FOG_PREFIXO', '24')
    if not RE_IFACE.match(iface or ''):
        raise Erro('Placa da rede de clonagem não configurada.')
    rede = ipaddress.IPv4Network(f'{ip}/{pref}', strict=False)
    sh(['nft', 'delete', 'table', 'ip', NAT_TABELA], verificar=False)
    r = sh(['nft', '-f', '-'], verificar=False, entrada=nat_regras_texto(iface, rede))
    if r.returncode != 0:
        raise Erro('O firewall recusou a regra do NAT: ' + r.stderr.strip()[-200:])
    sh(['sysctl', '-q', '-w', 'net.ipv4.ip_forward=1'])
    return iface, rede


def nat_ufw(iface, ligar):
    """Com o ufw ativo (repasse bloqueado por padrão), libera só o que entra pela placa da rede de clonagem."""
    if ligar:
        comando = ['ufw', 'route', 'allow', 'in', 'on', iface, 'comment', 'LabFreeImageDeploy-nat']
    else:
        comando = ['ufw', 'route', 'delete', 'allow', 'in', 'on', iface, 'comment', 'LabFreeImageDeploy-nat']
    return sh(comando, verificar=False).returncode == 0


def nat_ler(_entrada=None):
    conf = ler_conf()
    n = nat_conf()
    saida = nat_saida()
    tabela = sh(['nft', 'list', 'table', 'ip', NAT_TABELA], verificar=False).returncode == 0
    with open('/proc/sys/net/ipv4/ip_forward') as f:
        forward = f.read().strip() == '1'
    dns_saida = nat_dns_da_saida(saida['placa']) if saida else []
    return {'ligado': bool(n.get('ligado')), 'funcionando': bool(n.get('ligado')) and tabela and forward,
            'saida': saida, 'saida_e_clonagem': bool(saida) and saida['placa'] == conf.get('FOG_IFACE'),
            'dns': n.get('dns') or [], 'dns_sugerido': dns_saida or NAT_DNS_PADRAO, 'firewall': nat_firewall(),
            'servidor_ip': conf.get('FOG_IP', '')}


def nat_aplicar(e):
    conf = ler_conf()
    iface = conf.get('FOG_IFACE', '')
    ligar = bool(e.get('ligar'))
    antes = nat_conf()
    if not ligar and not antes.get('ligado'):
        return {'ok': True, 'msg': 'A internet para a rede de clonagem já estava desligada.', 'nat': nat_ler()}
    inst = Instantaneo('nat')
    for arq in (NAT_CONF, NAT_SYSCTL):
        inst.guardar(arq)
    dhcp_atual = dhcp_ler()
    with open('/proc/sys/net/ipv4/ip_forward') as f:
        forward_agora = f.read().strip()
    fw = nat_firewall()
    ufw_nesta_vez = False
    dhcp_mudou = False
    try:
        if ligar:
            saida = nat_saida()
            if not saida:
                raise Erro('Este servidor está sem internet (sem rota padrão). Conecte o Wi-Fi ou o cabo da internet primeiro.')
            if saida['placa'] == iface:
                raise Erro('A internet deste servidor está saindo pela própria placa da rede de clonagem: não há o que repassar.')
            dns = []
            for d in (e.get('dns') or []):
                d = str(d).strip()
                if d:
                    dns.append(str(ip_valido(d, 'DNS')))
            dns = dns[:2] or nat_dns_da_saida(saida['placa']) or NAT_DNS_PADRAO
            nat_carregar(conf)
            ufw_regra = bool(antes.get('ufw_regra'))
            if fw['ufw'] and not ufw_regra:
                if not nat_ufw(iface, True):
                    raise Erro('O firewall (ufw) recusou liberar o repasse da rede de clonagem.')
                ufw_regra = ufw_nesta_vez = True
            gravar_atomico(NAT_SYSCTL, '# LabFree ImageDeploy: NAT da rede de clonagem ligado\nnet.ipv4.ip_forward = 1\n', 0o644)
            # o DHCP passa a entregar o servidor como saída e o DNS; o que havia antes volta quando desligar
            anterior = antes['dhcp_anterior'] if antes.get('ligado') else {'gateway': dhcp_atual['gateway'], 'dns': dhcp_atual['dns']}
            dhcp_aplicar({**dhcp_atual, 'gateway': conf.get('FOG_IP'), 'dns': dns})
            dhcp_mudou = True
            novo = {'ligado': True, 'dns': dns, 'dhcp_anterior': anterior, 'ufw_regra': ufw_regra,
                    'forward_antes': antes.get('forward_antes', forward_agora) if antes.get('ligado') else forward_agora}
            gravar_atomico(NAT_CONF, json.dumps(novo, indent=1) + '\n', 0o600)
            sh(['systemctl', 'enable', NAT_SERVICO], verificar=False)
            msg = f"Internet ligada para a rede de clonagem (pela placa {saida['placa']})."
            if fw['outro_bloqueio']:
                msg += ' Atenção: outro firewall neste servidor bloqueia repasse; as máquinas podem continuar sem internet.'
            if not dhcp_atual['ativo']:
                msg += ' O DHCP do servidor está desligado: configure o DHCP da rede para usar este servidor como gateway.'
        else:
            sh(['nft', 'delete', 'table', 'ip', NAT_TABELA], verificar=False)
            if antes.get('ufw_regra'):
                nat_ufw(iface, False)
            if os.path.exists(NAT_SYSCTL):
                os.remove(NAT_SYSCTL)
            if antes.get('forward_antes', '0') != '1':
                sh(['sysctl', '-q', '-w', 'net.ipv4.ip_forward=0'], verificar=False)
            ant = antes.get('dhcp_anterior') or {}
            gw = ant.get('gateway', '') if ant.get('gateway', '') != conf.get('FOG_IP') else ''
            dhcp_aplicar({**dhcp_atual, 'gateway': gw, 'dns': ant.get('dns') or []})
            dhcp_mudou = True
            gravar_atomico(NAT_CONF, json.dumps({'ligado': False}) + '\n', 0o600)
            sh(['systemctl', 'disable', NAT_SERVICO], verificar=False)
            msg = 'Internet desligada para a rede de clonagem (o DHCP voltou a entregar o que entregava antes).'
    except Exception as ex:
        log(f'nat-aplicar FALHOU, desfazendo: {ex}')
        inst.restaurar()
        if dhcp_mudou:  # volta o DHCP de antes (o dhcp_aplicar já desfaz sozinho quando é ele que falha)
            try:
                dhcp_aplicar(dhcp_atual)
            except Exception as ex2:
                log(f'Aviso ao devolver o DHCP: {ex2}')
        if ufw_nesta_vez:
            nat_ufw(iface, False)
        if antes.get('ligado'):
            nat_carregar(conf)
            if antes.get('ufw_regra') and not ligar:
                nat_ufw(iface, True)
        else:
            sh(['nft', 'delete', 'table', 'ip', NAT_TABELA], verificar=False)
        sh(['sysctl', '-q', '-w', f'net.ipv4.ip_forward={forward_agora}'], verificar=False)
        if isinstance(ex, Erro):
            raise
        raise Erro(f'Não foi possível aplicar; tudo foi desfeito. Motivo: {ex}')
    log(f"nat-aplicar ok: {'ligado' if ligar else 'desligado'}")
    return {'ok': True, 'msg': msg, 'nat': nat_ler()}


def nat_restaurar(_entrada=None):
    """No boot (LabFreeImageDeploy-nat.service) e depois de trocar a placa/IP: recria a regra se o NAT está ligado."""
    if not nat_conf().get('ligado'):
        sh(['nft', 'delete', 'table', 'ip', NAT_TABELA], verificar=False)
        return {'ok': True, 'msg': 'NAT desligado.'}
    nat_carregar(ler_conf())
    return {'ok': True, 'msg': 'NAT ligado.'}


def reaplicar(_entrada=None):
    """Devolve todas as customizações do LabFree ImageDeploy (usar depois do installfog.sh, que regrava
    o Kea e o default.ipxe). Idempotente: rodar de novo não muda nada."""
    conf = ler_conf()
    iface, ip = conf.get('FOG_IFACE'), conf.get('FOG_IP')
    if not iface or not ip:
        raise Erro('Rede de clonagem ainda não configurada (/etc/LabFreeImageDeploy/LabFreeImageDeploy.conf). Use rede-aplicar primeiro.')
    feito = []
    inst = Instantaneo('reaplicar')
    escrever_nm_carrier(iface, inst)
    escrever_dropin_kea(iface, inst)
    escrever_udev(iface, inst)
    escrever_chrony(ipaddress.IPv4Network(f"{ip}/{conf.get('FOG_PREFIXO', 24)}", strict=False), inst)
    sh(['systemctl', 'daemon-reload'], verificar=False)
    sh(['udevadm', 'control', '--reload'], verificar=False)
    sh(['udevadm', 'trigger', '--action=add', f'/sys/class/net/{iface}'], verificar=False)
    feito.append('NetworkManager, drop-in do Kea, udev e NTP conferidos')
    if garantir_ipxe_ntp(ip, inst):
        feito.append('default.ipxe: linha ntp reinserida')
    if os.path.exists(KEA):
        dados = json.load(open(DHCP_SALVO)) if os.path.exists(DHCP_SALVO) else dhcp_ler()
        dhcp_aplicar(dados)
        feito.append('DHCP reaplicado' + (' (de /etc/LabFreeImageDeploy/dhcp.json)' if os.path.exists(DHCP_SALVO) else ''))
    if os.path.exists(FOG_CONFIG_PHP):
        feito += marca_aplicar()['feito']
        novos = servicos_aplicar()
        feito.append('serviços com o nome LabFreeImageDeploy-*' + (f' ({len(novos)} criados)' if novos else ''))
    if nat_conf().get('ligado'):
        nat_carregar(conf)
        feito.append('internet para a rede de clonagem (NAT) recriada')
    log('reaplicar ok: ' + '; '.join(feito))
    return {'ok': True, 'msg': 'Customizações reaplicadas.', 'feito': feito}


def imagem_apagar(e):
    """Apaga /images/<caminho> de uma imagem que já foi excluída do cadastro."""
    caminho = str(e.get('caminho', '')).strip()
    if not re.fullmatch(r'[A-Za-z0-9_-]{1,64}', caminho) or caminho.lower() in ('dev', 'postdownloadscripts', 'postinitscripts'):
        raise Erro('Pasta de imagem inválida.')
    raiz = os.path.realpath('/images')
    if os.path.islink(os.path.join(raiz, caminho)):
        raise Erro('Recusado: a pasta da imagem é um link simbólico.')
    alvo = os.path.realpath(os.path.join(raiz, caminho))
    if os.path.dirname(alvo) != raiz or os.path.basename(alvo) != caminho or not os.path.isdir(alvo):
        raise Erro('A pasta dessa imagem não existe.')
    if mysql(f"SELECT COUNT(*) FROM images WHERE imagePath='{caminho}'").strip() != '0':
        raise Erro('Esta pasta ainda pertence a uma imagem cadastrada.')
    tamanho = sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(alvo) for f in fs)
    shutil.rmtree(alvo)
    log(f"imagem-apagar: {alvo} ({tamanho} bytes)")
    return {'ok': True, 'bytes': tamanho}


DEV_IMAGENS = '/images/dev'
DEV_PARADA_MIN = 60  # pasta sem nenhuma gravação há menos tempo que isso pode ser uma captura começando


def dev_orfas_lista():
    """Pastas de captura em /images/dev (uma por MAC) que nenhuma tarefa ativa está usando: sobras de capturas
    que falharam ou foram canceladas (a base só move a pasta para a imagem quando a captura termina bem)."""
    raiz = os.path.realpath(DEV_IMAGENS)
    if not os.path.isdir(raiz):
        return []
    # MACs (sem separadores) das máquinas com qualquer tarefa ainda não terminada
    ocupadas = {re.sub(r'[^0-9a-f]', '', l.lower()) for l in mysql(
        "SELECT m.hmMAC FROM hostMAC m JOIN tasks t ON t.taskHostID = m.hmHostID WHERE t.taskStateID IN (0,1,2,3)").split('\n') if l}
    nomes = {}
    for l in mysql("SELECT m.hmMAC, h.hostName FROM hostMAC m JOIN hosts h ON h.hostID = m.hmHostID").split('\n'):
        if '\t' in l:
            mac, nome = l.split('\t', 1)
            nomes[re.sub(r'[^0-9a-f]', '', mac.lower())] = nome
    saida = []
    for nome in sorted(os.listdir(raiz)):
        caminho = os.path.join(raiz, nome)
        if not re.fullmatch(r'[0-9a-f]{12}', nome) or os.path.islink(caminho) or not os.path.isdir(caminho) or nome in ocupadas:
            continue
        tamanho, recente = 0, os.lstat(caminho).st_mtime
        for r, ds, fs in os.walk(caminho):
            for f in fs:
                st = os.lstat(os.path.join(r, f))
                tamanho += st.st_size
                recente = max(recente, st.st_mtime)
        if time.time() - recente < DEV_PARADA_MIN * 60:
            continue
        saida.append({'pasta': nome, 'mac': ':'.join(nome[i:i + 2] for i in range(0, 12, 2)), 'maquina': nomes.get(nome, ''),
                      'bytes': tamanho, 'modificada': int(recente)})
    return saida


def dev_orfas(e):
    """listar: sobras de capturas interrompidas em /images/dev. apagar: apaga as pastas pedidas, conferindo de novo
    cada uma (nome de MAC, sem link, nenhuma tarefa ativa da máquina, nada gravado na última hora)."""
    if e.get('acao', 'listar') == 'listar':
        return {'ok': True, 'orfas': dev_orfas_lista()}
    if e.get('acao') != 'apagar':
        raise Erro('Ação inválida.')
    pedidas = e.get('pastas')
    if not isinstance(pedidas, list) or not pedidas or not all(isinstance(p, str) and re.fullmatch(r'[0-9a-f]{12}', p) for p in pedidas):
        raise Erro('Escolha pelo menos uma pasta.')
    livres = {o['pasta']: o for o in dev_orfas_lista()}
    recusadas = [p for p in pedidas if p not in livres]
    if recusadas:
        raise Erro('Estas pastas não podem ser apagadas agora (em uso por uma tarefa, gravadas há pouco ou já apagadas): '
                   + ', '.join(recusadas))
    raiz = os.path.realpath(DEV_IMAGENS)
    total = 0
    for p in pedidas:
        alvo = os.path.join(raiz, p)
        if os.path.islink(alvo) or os.path.dirname(os.path.realpath(alvo)) != raiz:
            raise Erro(f'Recusado: {p} não é uma pasta comum.')
        shutil.rmtree(alvo)
        total += livres[p]['bytes']
        log(f"dev-orfas: apagada {alvo} ({livres[p]['bytes']} bytes, máquina {livres[p]['maquina'] or 'sem cadastro'})")
    return {'ok': True, 'apagadas': len(pedidas), 'bytes': total}


