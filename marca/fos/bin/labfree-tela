#!/bin/bash
# LabFree ImageDeploy - tela da maquina durante a captura ou restauracao (roda dentro do FOS).
#
# O processo original do FOG (/bin/fog) roda no terminal 2, gravado por "script" em /tmp/labfree.bruto.
# Esta tela, no terminal principal, le esse registro e o andamento do partclone (/tmp/status.fog) e mostra:
# etapas, porcentagem, velocidade, tempo restante e as ultimas mensagens - em portugues e sem acentos
# (o console de boot nao tem acentos). Envia a etapa atual ao servidor (painel) e, no fim, NAO reinicia:
# mostra o resultado e deixa reiniciar, desligar ou ver o registro completo.
. /usr/share/fog/lib/funcs.sh
export LABFREE_TELA=1

BRUTO=/tmp/labfree.bruto     # tudo o que o FOG escreveu na tela (com codigos de terminal)
LOG=/tmp/labfree.log         # mensagens limpas, uma por linha (o "registro")
RC=/tmp/labfree.rc           # codigo de saida do /bin/fog
RES=/tmp/labfree.resultado   # motivo do erro (gravado pelo handleError do LabFree)
STATUS=/tmp/status.fog       # andamento do partclone: bpm@decorrido@restante@copiado@total@pct@...
rm -f "$BRUTO" "$RC" "$RES" "$STATUS"
: > "$LOG"
OFF=0
ETAPA=1
PARTE=0
INICIO=$SECONDS
ULTIMO_ENVIO=""
ULTIMO_ENVIO_T=0
ULTIMO_NLIN=""   # quantas linhas do registro o painel ja recebeu
VELOCIDADE=""
MACS=$(getMACAddresses)
UUID=$(dmidecode -s system-uuid 2>/dev/null)
UUID=${UUID,,}
NOME_MAQ=${hostname:-}
[[ -z $NOME_MAQ || $NOME_MAQ == fogclient* ]] && NOME_MAQ="sem cadastro"   # máquina que entrou no grupo sem estar cadastrada
IMG_NOME=${img:-}
titulos() {
    case $type in
        up) TITULO="Capturando o disco para a imagem: $IMG_NOME"; TITULO_FIM="Disco capturado para a imagem: $IMG_NOME"
            TITULO_CURTO="Capturando o disco"; MODO_TEXTO="Captura: o disco desta máquina vai para o servidor"
            ETAPAS=("Conectando ao servidor" "Verificando o disco" "Preparando as particoes" "Copiando o disco para o servidor" "Finalizando") ;;
        *)  TITULO="Restaurando a imagem: $IMG_NOME"; TITULO_FIM="Imagem restaurada: $IMG_NOME"
            TITULO_CURTO="Restaurando a imagem"; MODO_TEXTO="Restaurando: o disco desta máquina será substituído"
            [[ $mc == yes ]] && { TITULO="Restaurando em grupo (multicast): $IMG_NOME"; TITULO_CURTO="Restaurando em grupo"; MODO_TEXTO="Em grupo: um só envio para a sala inteira"; }
            ETAPAS=("Conectando ao servidor" "Verificando o disco" "Preparando as particoes" "Gravando a imagem no disco" "Finalizando") ;;
    esac
}
titulos

. /usr/share/fog/lib/labfree-cores.sh
E=$'\e'
# cores (paleta LabFree em labfree-cores.sh): fundo marinho, cartao em marinho claro (45), barra azul (44)
Z="${E}[0m"; N="${E}[1;37m"; FRACO="${E}[1;30m"; CIANO="${E}[1;36m"; VERDE="${E}[1;32m"; AMARELO="${E}[1;33m"
VERMELHO="${E}[1;31m"; CINZA="${E}[0;37m"; CAB="${E}[0;37;44m"; CAB_N="${E}[1;37;44m"
CARD="${E}[0;37;45m"; CARD_N="${E}[1;37;45m"; CARD_FRACO="${E}[1;30;45m"; CARD_CIANO="${E}[1;36;45m"
CARD_VERDE="${E}[1;32;45m"; CARD_VERMELHO="${E}[1;31;45m"; CARD_AMARELO="${E}[1;33;45m"; TECLA="${E}[1;37;44m"

# ------------------------------------------------------------------ textos em portugues

traduzir() { # " * Looking for Hard Disk(s)......Done" -> "Procurando o disco ... ok"
    local l="$1" msg st
    l="${l# }"; l="${l#\* }"
    msg=$(printf '%s' "$l" | sed -E 's/\.{3,}.*$//; s/[[:space:]]+$//')
    st=$(printf '%s' "$l" | sed -nE 's/.*\.{3,}[[:space:]]*([A-Za-z].*)$/\1/p')
    case "$msg" in
        "Attempting to check in"*) msg="Avisando o servidor que a maquina ligou" ;;
        "Mounting File System"*|"Mounting directory"*) msg="Conectando a pasta de imagens do servidor" ;;
        "Checking Mounted File System"*) msg="Conferindo a pasta de imagens" ;;
        "Checking img variable"*) msg="Conferindo a imagem escolhida" ;;
        "Using Image:"*) msg="Imagem: ${msg#Using Image: }" ;;
        "Checking CPU Cores"*) msg="Contando os processadores" ;;
        "Send method"*) msg="Forma de envio" ;;
        "Write caching not supported"*) msg="Cache de gravacao nao disponivel neste disco (normal)" ;;
        "Using Hard Disk:"*|"Using Disk:"*) msg="Disco: ${msg#*Disk: }" ;;
        "Resetting UUIDs"*) msg="Restaurando os identificadores do disco" ;;
        "Disk UUID being set"*|"Partition type being set"*|"Partition uuid being set"*) msg="Ajustando os identificadores das particoes" ;;
        "Resetting swap"*) msg="Ajustando a particao de troca (swap)" ;;
        "Using partclone."*) msg="Copiando com partclone (${msg#Using partclone.})" ;;
        "Processing Hard Disk:"*) msg="Disco: ${msg#Processing Hard Disk: }" ;;
        "Image Captured"*) msg="Parte copiada para o servidor" ;;
        "Image Restored"*|"Image restored"*) msg="Parte gravada no disco" ;;
        "Not expanding"*"fixed size"*) msg="Particao de tamanho fixo mantida (${msg#*(}"; msg="${msg%%)*})" ;;
        "Expanding"*) msg="Expandindo a particao para ocupar o disco" ;;
        "Task Complete"*) msg="Tarefa concluida" ;;
        "Looking for Hard Disk"*) msg="Procurando o disco da maquina" ;;
        "Reading Partition Tables"*) msg="Lendo as particoes do disco" ;;
        "Checking Operating System"*) msg="Identificando o sistema operacional" ;;
        "Getting Windows/Linux Partition Count"*) msg="Contando as particoes" ;;
        "Enabling write cache"*) msg="Ativando o cache de gravacao do disco" ;;
        "Erasing current MBR/GPT"*) msg="Apagando a tabela de particoes antiga" ;;
        "Restoring Partition Tables"*|"Restoring Original Partition Layout"*) msg="Recriando as particoes" ;;
        "Preparing Partition layout"*) msg="Preparando o layout das particoes" ;;
        "Attempting to expand/fill partitions"*) msg="Ajustando as particoes ao tamanho do disco" ;;
        "Checking for fixed partitions"*) msg="Conferindo particoes de tamanho fixo" ;;
        "Saving Partition Tables"*|"Saving original partition table"*) msg="Guardando a tabela de particoes" ;;
        "Running resize test"*) msg="Testando se o disco pode ser reduzido" ;;
        "Shrinking"*) msg="Reduzindo o sistema de arquivos para copiar mais rapido" ;;
        "Resizing filesystem"*|"Resizing partition"*|"Resizing"*|"Attempting to resize"*) msg="Ajustando o tamanho do sistema de arquivos" ;;
        "Removing page file"*) msg="Removendo o arquivo de paginacao do Windows" ;;
        "Removing hibernate file"*) msg="Removendo o arquivo de hibernacao do Windows" ;;
        "Clearing ntfs flag"*) msg="Ajustando o NTFS" ;;
        "Processing Partition:"*) msg=$(printf '%s' "$msg" | sed -E 's/^Processing Partition: ([^ ]+) \(([0-9]+)\).*/Parte \2 do disco (\1)/') ;;
        "Imaging using"*) msg="Transferindo dados (${msg#Imaging using })" ;;
        "Changing hostname"*) msg="Trocando o nome da maquina no Windows" ;;
        "Updating Database"*) msg="Registrando a conclusao no servidor" ;;
        "Reattempting to update database"*) msg="Tentando de novo registrar no servidor" ;;
        "Stopping FOG Status Reporter"*) msg="Encerrando o envio de andamento" ;;
        "Attempting to send inventory"*) msg="Enviando o inventario da maquina" ;;
        "Running post init scripts"*) msg="Preparando o ambiente de clonagem" ;;
        "Verifying network interface"*) msg="Conferindo a placa de rede" ;;
        "Setting boot partition"*) msg="Marcando a particao de boot" ;;
        "Backing up and replacing BCD"*) msg="Ajustando a inicializacao do Windows (BCD)" ;;
        "Correcting Vista MBR"*) msg="Ajustando o MBR" ;;
        "Mounting partition"*) msg="Abrindo uma particao" ;;
        "Seems like you are trying to restore to an empty disk"*) msg="Disco vazio: sera preparado do zero" ;;
        "Skipping partition"*) msg="Etapa de particoes nao necessaria" ;;
        "ERRO:"*|"AVISO:"*) ;;
    esac
    case "$st" in
        Done|OK|Yes) st="ok" ;;
        Failed) st="FALHOU" ;;
        Skipped|No) st="pulado" ;;
    esac
    [[ -n $st ]] && printf '%s ... %s' "$msg" "$st" || printf '%s' "$msg"
}

etapa_de() { # mensagem original -> numero da etapa (so avanca)
    case "$1" in
        *"Processing Partition"*|*"Imaging using"*) echo 4 ;;
        *"Updating Database"*|*"Changing hostname"*|*"Task Complete"*) echo 5 ;;
        *"Erasing"*|*"Restoring Partition"*|*"Restoring Original"*|*"Preparing Partition"*|*"Saving Partition"*|*"Saving original"*|*"Shrinking"*|*"Running resize test"*|*"expand/fill"*|*"Removing"*|*"Recreating"*) echo 3 ;;
        *"Looking for Hard Disk"*|*"Reading Partition"*|*"Checking Operating System"*|*"Getting Windows"*|*"Enabling write cache"*) echo 2 ;;
        *) echo 0 ;;
    esac
}

# ------------------------------------------------------------------ leitura do registro

processar() { # le o que o FOG escreveu desde a ultima vez (so linhas completas)
    local tam pedaco linhas usado linha e
    tam=$(stat -c %s "$BRUTO" 2>/dev/null || echo 0)
    (( tam > OFF )) || return 0
    pedaco=/tmp/labfree.pedaco
    tail -c +$((OFF + 1)) "$BRUTO" 2>/dev/null | head -c $((tam - OFF)) > "$pedaco"
    linhas=$(tr -cd '\n' < "$pedaco" | wc -c)
    (( linhas > 0 )) || return 0
    usado=$(head -n "$linhas" "$pedaco" | wc -c)
    OFF=$((OFF + usado))
    head -n "$linhas" "$pedaco" \
        | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\x1b[()][0-9A-Za-z]//g' -e 's/\x1b[=>78]//g' \
        | tr '\r' '\n' | tr -d '\000-\010\013\014\016-\037\177' \
        | grep -aE '^ ?\* |ERRO:|AVISO:' > /tmp/labfree.novas
    while IFS= read -r linha; do
        e=$(etapa_de "$linha")
        (( e > ETAPA )) && ETAPA=$e
        [[ $linha == *"Processing Partition"* ]] && PARTE=$((PARTE + 1))
        linha=$(traduzir "$linha")
        [[ $linha == "$(tail -n 1 "$LOG")" ]] || printf '%s\n' "$linha" >> "$LOG"   # sem repetir a mesma linha seguida
    done < /tmp/labfree.novas
}

total_partes() { # restauracao: quantas partes a imagem tem (d1p1.img, d1p2.img...)
    [[ $type == up ]] && return
    ls /images/"$img"/ 2>/dev/null | sed -nE 's/^d1p([0-9]+)\.img.*/\1/p' | sort -u | wc -l
}

# ------------------------------------------------------------------ servidor (painel)

enviar() { # envia a etapa atual ao painel (so quando muda, ou a cada 30 s) e as ultimas linhas do registro
    local texto="$1" final="${2:-}" chave nlin reg=()
    [[ -z $web ]] && return 0
    nlin=$(wc -l < "$LOG" 2>/dev/null || echo 0)
    chave="$ETAPA|$PARTE|$texto|$nlin"
    if [[ -z $final && $chave == "$ULTIMO_ENVIO" && $((SECONDS - ULTIMO_ENVIO_T)) -lt 30 ]]; then
        return 0
    fi
    ULTIMO_ENVIO="$chave"; ULTIMO_ENVIO_T=$SECONDS
    if [[ -n $final ]]; then
        tail -c 60000 "$LOG" > /tmp/labfree.envio
        curl -Lks --max-time 15 --data-urlencode "mac=$MACS" --data-urlencode "sysuuid=$UUID" \
            --data-urlencode "etapa=$ETAPA" --data-urlencode "etapas=${#ETAPAS[@]}" --data-urlencode "texto=$texto" \
            --data-urlencode "parte=$PARTE" --data-urlencode "resultado=$final" \
            --data-urlencode "mensagem=$(head -c 2000 "$RES" 2>/dev/null)" --data-urlencode "registro@/tmp/labfree.envio" \
            "${web}service/LabFreeImageDeploy-etapa.php" >/dev/null 2>&1 || :
    else
        if [[ $nlin != "$ULTIMO_NLIN" ]]; then # registro ao vivo no painel: so quando entrou linha nova
            ULTIMO_NLIN=$nlin
            tail -n 40 "$LOG" > /tmp/labfree.vivo.$$ 2>/dev/null && mv -f /tmp/labfree.vivo.$$ /tmp/labfree.vivo
            reg=(--data-urlencode "registro@/tmp/labfree.vivo")
        fi
        ( curl -Lks --max-time 5 --data-urlencode "mac=$MACS" --data-urlencode "sysuuid=$UUID" \
            --data-urlencode "etapa=$ETAPA" --data-urlencode "etapas=${#ETAPAS[@]}" --data-urlencode "texto=$texto" \
            --data-urlencode "parte=$PARTE" --data-urlencode "velocidade=${VELOCIDADE:+$VELOCIDADE/min}" "${reg[@]}" \
            "${web}service/LabFreeImageDeploy-etapa.php" >/dev/null 2>&1 & )
    fi
}

# ------------------------------------------------------------------ desenho (identidade LabFree)

tamanho() { read -r LIN COL < <(stty -F /dev/tty1 size 2>/dev/null); LIN=${LIN:-25}; COL=${COL:-80}; (( COL > 140 )) && COL=140; }
pos() { printf '%s[%d;%dH' "$E" "$1" "${2:-1}"; }                        # cursor (linha, coluna)
limpa() { printf '%s[%d;1H%s%s[K' "$E" "$1" "$Z" "$E"; }                  # linha inteira no fundo marinho
ascii() { # textos variaveis sem acento: o console nao tem locale e o corte de bytes estragaria um acento
    sed -e 's/á/a/g;s/à/a/g;s/â/a/g;s/ã/a/g;s/é/e/g;s/ê/e/g;s/í/i/g;s/ó/o/g;s/ô/o/g;s/õ/o/g;s/ú/u/g;s/ç/c/g' \
        -e 's/Á/A/g;s/À/A/g;s/Â/A/g;s/Ã/A/g;s/É/E/g;s/Ê/E/g;s/Í/I/g;s/Ó/O/g;s/Ô/O/g;s/Õ/O/g;s/Ú/U/g;s/Ç/C/g' \
        | tr -cd '\11\12\40-\176'
}
corte() { local s; s=$(printf '%s' "$1" | ascii); local m=$((COL - ${2:-4})); (( m < 10 )) && m=10; printf '%s' "${s:0:$m}"; }
larg() { printf '%s' "$1" | tr -d '\200-\277' | wc -c; }                  # caracteres de um texto fixo (UTF-8)
tempo() { local s=$1; printf '%02d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60)); }

faixa() { # faixa LINHA COR: pinta a linha inteira com uma cor de fundo
    printf '%s[%d;1H%s%*s' "$E" "$1" "$2" "$COL" ""
}
cartao() { # cartao LINHA_INI LINHA_FIM: area em marinho claro, com margem de 2 colunas
    local y
    for ((y = $1; y <= $2; y++)); do printf '%s[%d;3H%s%*s%s' "$E" "$y" "$CARD" $((COL - 4)) "" "$Z"; done
}
nuvem() { # nuvem da LabFree (3 linhas) a partir de LINHA, COLUNA: ciano a esquerda, azul a direita (como o logo)
    pos "$1" "$2"; printf '%s   ▄%s▄██▄▄%s' "$CIANO" "${E}[1;34m" "$Z"
    pos $(($1 + 1)) "$2"; printf '%s ▄███%s██████▄%s' "$CIANO" "${E}[1;34m" "$Z"
    pos $(($1 + 2)) "$2"; printf '%s▀████%s███████▀%s' "$CIANO" "${E}[0;34m" "$Z"
}
regua() { local i out=""; for ((i = 0; i < $1; i++)); do out+="─"; done; printf '%s' "$out"; }
msg() { # uma linha do registro com o simbolo certo (LINHA COLUNA TEXTO)
    pos "$1" "$2"
    case "$3" in
        *FALHOU*|ERRO*) printf '%s✕ %s%s' "$VERMELHO" "$(corte "$3" 6)" "$Z" ;;
        AVISO*) printf '%s! %s%s' "$AMARELO" "$(corte "$3" 6)" "$Z" ;;
        *"... ok") printf '%s√ %s%s%s' "$VERDE" "$CINZA" "$(corte "${3%... ok}" 6)" "$Z" ;;
        *) printf '%s• %s%s%s' "$FRACO" "$CINZA" "$(corte "$3" 6)" "$Z" ;;
    esac
}

cabecalho() {
    local dir esq_l dir_l
    dir="Máquina: $(printf '%s' "$NOME_MAQ" | ascii | cut -c1-24) "
    faixa 1 "$CAB"
    pos 1 2; printf '%sLABFREE%s ImageDeploy' "$CAB_N" "$CAB"
    dir_l=$(larg "$dir")
    pos 1 $((COL - dir_l)); printf '%s%s%s' "$CAB" "$dir" "$Z"
}

rodape() { # rodape TEXTO_FIXO
    local t="$1" site="labfree.com.br "
    limpa "$LIN"
    pos "$LIN" 3; printf '%s%s' "$FRACO" "$t"
    pos "$LIN" $((COL - ${#site})); printf '%s%s%s' "$FRACO" "$site" "$Z"
}

barra() { # barra PCT LARGURA (dentro do cartao)
    local p=$1 w=$2 cheio i out=""
    cheio=$((p * w / 100))
    printf '%s' "$CARD_CIANO"
    for ((i = 0; i < cheio; i++)); do out+="█"; done; printf '%s' "$out"; out=""
    printf '%s' "$CARD_FRACO"
    for ((i = cheio; i < w; i++)); do out+="░"; done; printf '%s%s' "$out" "$Z"
}

trilha() { # LINHA: Conectar - Verificar - Particoes - Gravar - Finalizar
    local y=$1 i n x=3 nome
    local curtos=("Conectar" "Verificar o disco" "Particionar" "$([[ $type == up ]] && echo Copiar || echo Gravar)" "Finalizar")
    limpa "$y"
    for i in "${!curtos[@]}"; do
        n=$((i + 1)); nome="${curtos[$i]}"
        pos "$y" "$x"
        if (( n < ETAPA )); then printf '%s√ %s%s' "$VERDE" "$CINZA" "$nome"
        elif (( n == ETAPA )); then printf '%s► %s%s' "$CIANO" "$N" "$nome"
        else printf '%s○ %s' "$FRACO" "$nome"; fi
        x=$((x + 2 + $(larg "$nome")))
        if (( n < ${#curtos[@]} )); then pos "$y" "$x"; printf '%s ── ' "$FRACO"; x=$((x + 4)); fi
    done
    printf '%s' "$Z"
}

topo() { # cabecalho + nuvem + titulo (TITULO, SUBTITULO)
    cabecalho
    limpa 2; limpa 3; limpa 4; limpa 5; limpa 6
    nuvem 3 3
    pos 3 17; printf '%s%s%s' "$N" "$1" "$Z"
    pos 4 17; printf '%s%s%s' "$CIANO" "$(corte "$IMG_NOME" 20)" "$Z"
    pos 5 17; printf '%s%s%s' "$FRACO" "$2" "$Z"
}

desenhar() {
    local i linha bpm dec rest cop tot pct agora total largura y max detalhe
    tamanho
    topo "$TITULO_CURTO" "$MODO_TEXTO"
    trilha 7
    detalhe="Etapa $((ETAPA > ${#ETAPAS[@]} ? ${#ETAPAS[@]} : ETAPA)) de ${#ETAPAS[@]} - ${ETAPAS[$((ETAPA - 1))]}"
    if (( ETAPA == 4 && PARTE > 0 )); then
        total=$(total_partes); detalhe="$detalhe - parte $PARTE${total:+ de $total}"
        [[ $total == 0 ]] && detalhe="${detalhe% de 0}"
    fi
    limpa 8; pos 8 3; printf '%s%s%s' "$FRACO" "$(corte "$detalhe")" "$Z"
    pct=""; bpm=""; dec=""; rest=""; cop=""; tot=""
    if (( ETAPA == 4 )) && [[ -s $STATUS ]]; then
        IFS='@' read -r bpm dec rest cop tot pct _ < <(tail -n 1 "$STATUS" 2>/dev/null)
        pct=$(printf '%s' "$pct" | tr -dc '0-9.'); pct=${pct%%.*}; [[ $pct =~ ^[0-9]+$ ]] || pct=0
        (( pct > 100 )) && pct=100
        VELOCIDADE=$(printf '%s' "$bpm" | tr -d ' ')
        [[ $VELOCIDADE =~ ^0+([.,]0+)?[A-Za-z]*$ ]] && VELOCIDADE=""   # "0.00byte" no comeco: ainda sem medida
    fi
    agora=$(tail -n 1 "$LOG" 2>/dev/null)
    # cartao do andamento
    limpa 9; cartao 10 14; limpa 15
    largura=$((COL - 18))
    pos 11 5
    if [[ -n $pct ]]; then
        printf '%s%s%s' "$CARD_N" "$([[ $type == up ]] && echo 'Copiando para o servidor' || echo 'Gravando no disco')" "$Z"
        pos 11 $((COL - 8)); printf '%s%4d%%%s' "$CARD_N" "$pct" "$Z"
        pos 12 5; barra "$pct" $((COL - 8))
        pos 13 5; printf '%s%s%s' "$CARD" "$(corte "$(printf '%s de %s   |   %s/min   |   faltam %s' "${cop:-?}" "${tot:-?}" "${VELOCIDADE:-?}" "${rest:-?}")" 10)" "$Z"
    else
        printf '%sAgora:%s %s' "$CARD_N" "$CARD" "$(corte "${agora:-Iniciando...}" 16)"
        pos 12 5; barra $(( (ETAPA - 1) * 100 / ${#ETAPAS[@]} )) $((COL - 8))
        pos 13 5; printf '%sAs etapas acima mostram onde estamos.%s' "$CARD_FRACO" "$Z"
    fi
    pos 13 $((COL - 17)); printf '%stotal %s%s' "$CARD_FRACO" "$(tempo $((SECONDS - INICIO)))" "$Z"
    # registro
    limpa 16; pos 16 3; printf '%sRegistro %s%s%s' "$N" "$FRACO" "$(regua $((COL - 13)))" "$Z"
    y=17; max=$((LIN - y - 1)); (( max < 3 )) && max=3
    i=0
    while IFS= read -r linha; do
        limpa $((y + i)); msg $((y + i)) 3 "$linha"
        i=$((i + 1))
    done < <(tail -n "$max" "$LOG")
    while (( y + i < LIN )); do limpa $((y + i)); i=$((i + 1)); done
    rodape "Mantenha a máquina ligada   ·   Alt+F2: detalhes técnicos"
    enviar "${agora:-Iniciando}"
}

explicar() { # erro tecnico do FOG -> explicacao simples
    local t; t=$(tr '\n' ' ' < "$RES" 2>/dev/null)
    case "$t" in
        *"partition table"*|*sgdisk*|*sfdisk*) echo "Nao foi possivel recriar as particoes: o disco desta maquina provavelmente e menor que o da imagem." ;;
        *"not large enough"*|*"too small"*|*"smaller than"*) echo "O disco desta maquina e menor que o necessario para esta imagem." ;;
        *"Could not find"*[Dd]isk*|*"No hard disk"*|*"Unable to locate"*disk*) echo "Nenhum disco encontrado. Na BIOS, confira se o disco aparece e se o modo SATA esta em AHCI." ;;
        *e2fsck*|*"recovering journal"*|*needs_recovery*) echo "O Linux desta maquina nao foi desligado corretamente. Ligue a maquina pelo disco, desligue pelo menu (Desligar) e tente de novo." ;;
        *hibernat*|*unclean*|*dirty*) echo "O Windows nao foi desligado por completo. Desligue segurando Shift e tente de novo." ;;
        *BitLocker*) echo "O disco esta protegido pelo BitLocker. Desative o BitLocker no Windows e tente de novo." ;;
        *"image store"*|*"locate file"*) echo "Os arquivos da imagem nao foram encontrados no servidor." ;;
        *checksum*|*"Decoding error"*|*corrupt*) echo "Os dados chegaram diferentes do original (imagem ou rede com problema). Nada foi aproveitado: tente de novo." ;;
        *space*) echo "Falta espaco (no servidor ou no disco desta maquina)." ;;
        *mount*|*nfs*|*NFS*) echo "A maquina nao conseguiu acessar a pasta de imagens do servidor (rede)." ;;
        *) echo "" ;;
    esac
}

ver_arquivo() { # visualizador simples (o "less" nao funciona sem terminal controlador): setas, PgUp/PgDn, Q
    local arq="$1" titulo="$2" total topo=0 alt i tecla resto
    mapfile -t LINHAS < "$arq"
    total=${#LINHAS[@]}
    tamanho
    alt=$((LIN - 3))
    topo=$((total > alt ? total - alt : 0))   # comeca pelo fim (o mais recente)
    while :; do
        printf '%s%s[2J' "$Z" "$E"
        faixa 1 "$CAB"; pos 1 2; printf '%sLABFREE%s %s%s' "$CAB_N" "$CAB" "$titulo" "$Z"
        for ((i = 0; i < alt; i++)); do
            pos $((i + 2)) 2; printf '%s%s%s' "$CINZA" "$(corte "${LINHAS[$((topo + i))]:-}" 3)" "$Z"
        done
        rodape "Linhas $((topo + 1))-$((topo + alt < total ? topo + alt : total)) de $total   ·   Setas e PgUp/PgDn: rolar   ·   Q: voltar"
        read -rsn1 -u 3 tecla || { sleep 1; continue; }
        if [[ $tecla == $'\e' ]]; then read -rsn3 -t 0.1 -u 3 resto; tecla+="$resto"; fi
        case "$tecla" in
            q|Q) return ;;
            $'\e[A'*|k) ((topo > 0)) && topo=$((topo - 1)) ;;
            $'\e[B'*|j|"") ((topo + alt < total)) && topo=$((topo + 1)) ;;
            $'\e[5'*|b) topo=$((topo - alt)); ((topo < 0)) && topo=0 ;;
            $'\e[6'*|" ") topo=$((topo + alt)); ((topo + alt > total)) && topo=$((total > alt ? total - alt : 0)) ;;
        esac
    done
}

tecla_opcao() { printf '%s %s %s %s%s   ' "$TECLA" "$1" "$Z" "$CINZA" "$2"; }

tela_final() {
    local y i linha motivo
    tamanho
    printf '%s%s[2J' "$Z" "$E"
    if [[ $RESULTADO == sucesso ]]; then
        topo "Concluído com sucesso" "Tempo total: $(tempo $DURACAO)"
        pos 3 17; printf '%s√ Concluído com sucesso%s' "$VERDE" "$Z"
        trilha 7
        cartao 9 12
        pos 10 5; printf '%s%s%s' "$CARD_VERDE" "$(corte "$TITULO_FIM" 10)" "$Z"
        pos 11 5
        if [[ $type == up ]]; then printf '%sA imagem foi guardada no servidor e já pode ser restaurada.%s' "$CARD" "$Z"
        else printf '%sO sistema foi gravado no disco. Reinicie para usar a máquina.%s' "$CARD" "$Z"; fi
        y=14
    else
        topo "O processo terminou com erro" "Tempo total: $(tempo $DURACAO)"
        pos 3 17; printf '%s✕ O processo terminou com erro%s' "$VERMELHO" "$Z"
        trilha 7
        motivo=$(explicar)
        cartao 9 14
        pos 10 5; printf '%sMotivo%s' "$CARD_VERMELHO" "$Z"
        i=0   # explicacao em ate 2 linhas, depois o erro tecnico (cinza)
        while IFS= read -r linha && (( i < 2 )); do pos $((11 + i)) 5; printf '%s%s%s' "$CARD_N" "$linha" "$Z"; i=$((i + 1)); done \
            < <(printf '%s\n' "${motivo:-$(head -n 1 "$RES")}" | ascii | fold -s -w $((COL - 10)))
        while IFS= read -r linha && (( i < 4 )); do pos $((11 + i)) 5; printf '%s%s%s' "$CARD_FRACO" "$(corte "$linha" 10)" "$Z"; i=$((i + 1)); done < "$RES"
        y=16
    fi
    pos "$y" 3; printf '%sRegistro %s%s%s' "$N" "$FRACO" "$(regua $((COL - 13)))" "$Z"
    i=0
    while IFS= read -r linha; do
        msg $((y + 1 + i)) 3 "$linha"; i=$((i + 1))
    done < <(sed '/^====/,$d' "$LOG" | grep -v '^$' | tail -n $((LIN - y - 4)))
    limpa $((LIN - 2)); pos $((LIN - 2)) 3
    tecla_opcao R Reiniciar; tecla_opcao D Desligar; tecla_opcao L "Ver o registro"; tecla_opcao T "Detalhes técnicos"
    printf '%s' "$Z"
}

demo() { # labfreedemo=progresso|preparando|sucesso|erro|grupo (na linha do kernel): desenha a tela com dados de exemplo
    type=${type:-down}; IMG_NOME="Laboratorio Fontes"; NOME_MAQ="LAB-007"
    [[ $1 == captura ]] && type=up
    titulos; LOG=/tmp/labfree.demo; : > "$LOG"
    printf '%s\n' "Avisando o servidor que a maquina ligou ... ok" "Conectando a pasta de imagens do servidor ... ok" \
        "Procurando o disco da maquina ... ok" "Disco: /dev/sda" "Lendo as particoes do disco ... ok" "Recriando as particoes ... ok" \
        "Parte 1 do disco (/dev/sda1)" "Parte gravada no disco" "Parte 3 do disco (/dev/sda3)" "Transferindo dados (Partclone (zstd))" >> "$LOG"
    ETAPA=4; PARTE=3; INICIO=$((SECONDS - 754)); DURACAO=1312
    printf '1.95GB@00:09:12@00:06:40@14.20GB@22.10GB@64.25@x\n' > "$STATUS"
    case "$1" in
        preparando) ETAPA=3; PARTE=0; rm -f "$STATUS" ;;
        grupo) mc=yes; titulos ;;
        sucesso) RESULTADO=sucesso; ETAPA=6 ;;
        erro) RESULTADO=erro; printf 'Could not restore partition table (sgdisk: disk too small)\nsgdisk -g /dev/sda failed with code 4\n' > "$RES"
              echo "Recriando as particoes ... FALHOU" >> "$LOG" ;;
    esac
    exec 3<>/dev/tty1; exec 1>&3 2>/dev/null
    labfree_paleta; printf '%s[?25l%s[?7l%s%s[2J' "$E" "$E" "$Z" "$E"; chvt 1 2>/dev/null
    web=""   # nada vai para o servidor
    case "$1" in sucesso|erro) tela_final ;; *) desenhar ;; esac
    sleep 100000
}

# ------------------------------------------------------------------ execucao

# a tela usa o terminal 1 so dela; o FOG roda no terminal 2 (stdin, stdout e stderr la), assim nada do FOG
# mexe no modo do terminal desta tela (o "script" deixava a entrada em modo nao bloqueante e o teclado parava)
[[ -n ${labfreedemo:-} ]] && demo "$labfreedemo"
exec 3<>/dev/tty1
exec 1>&3 2>/dev/null
stty -F /dev/tty1 sane 2>/dev/null
stty -F /dev/tty1 -echo -icanon 2>/dev/null   # tecla apertada durante a clonagem não aparece por cima da tela
labfree_paleta
printf '%s[?25l%s[?7l%s%s[2J' "$E" "$E" "$Z" "$E"   # esconde o cursor, desliga a quebra automatica de linha e limpa
chvt 1 2>/dev/null
setsid /bin/bash -c "script -qfec /bin/fog $BRUTO </dev/tty2 >/dev/tty2 2>&1; echo \$? > $RC" </dev/null >/dev/null 2>&1 &
while [[ ! -s $RC ]]; do
    processar
    desenhar
    sleep 1
done
processar
codigo=$(cat "$RC")
DURACAO=$((SECONDS - INICIO))

# ------------------------------------------------------------------ fim: resultado, sem reiniciar sozinho

if [[ $codigo == 0 && ! -s $RES ]]; then
    RESULTADO=sucesso; ETAPA=$(( ${#ETAPAS[@]} + 1 ))
else
    RESULTADO=erro
    [[ -s $RES ]] || printf 'O processo terminou com erro (codigo %s). Veja o registro.\n' "$codigo" > "$RES"
fi
cp "$LOG" /tmp/labfree-registro.txt
{
    echo
    echo "==== Resultado: $RESULTADO  |  duracao $(tempo $DURACAO)  |  $(date '+%d/%m/%Y %H:%M') ===="
    [[ -s $RES ]] && { echo "Motivo:"; cat "$RES"; }
} >> /tmp/labfree-registro.txt
LOG=/tmp/labfree-registro.txt
enviar "$([[ $RESULTADO == sucesso ]] && echo 'Concluido com sucesso' || head -n 1 "$RES")" "$RESULTADO"

# descarta o que foi digitado durante a clonagem (um "r" ou "d" perdido reiniciaria/desligaria antes de alguém ver)
while read -rsn1 -t 0.05 -u 3 _; do :; done
ESPERA=""
[[ $shutdown -eq 1 ]] && ESPERA=60    # "desligar quando terminar" no painel: desliga sozinha em 60 s
while :; do
    tela_final
    if [[ -n $ESPERA ]]; then
        limpa "$LIN"; pos "$LIN" 3; printf '%sDesligando em %s s (aperte qualquer tecla para cancelar)%s' "$AMARELO" "$ESPERA" "$Z"
        if read -rsn1 -t 1 -u 3 tecla; then ESPERA=""; else ESPERA=$((ESPERA - 1)); (( ESPERA <= 0 )) && poweroff -f; continue; fi
    else
        rodape "Escolha uma opção (aperte a letra)"
        read -rsn1 -u 3 tecla || sleep 1
    fi
    case "${tecla,,}" in
        r) printf '%s%s[2J%s[H Reiniciando...\n' "$Z" "$E" "$E"; sync; reboot -f ;;
        d) printf '%s%s[2J%s[H Desligando...\n' "$Z" "$E" "$E"; sync; poweroff -f ;;
        l) ver_arquivo "$LOG" "Registro completo" ;;
        t) sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\x1b[()][0-9A-Za-z]//g' "$BRUTO" | tr '\r' '\n' \
               | tr -d '\000-\010\013\014\016-\037\177' | grep -av '^[[:space:]]*$' > /tmp/labfree-tecnico.txt
           ver_arquivo /tmp/labfree-tecnico.txt "Detalhes tecnicos (tudo o que o sistema de clonagem escreveu)" ;;
    esac
done
